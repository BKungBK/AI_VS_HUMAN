# Local rehearsal needs no external credentials.
GAME_PORT=5180
GAME_DATA_DIR=data/pg

# Hosted API (set as private environment variables in the hosting dashboard).
# GAME_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# GAME_HOST_KEY=replace-with-a-long-random-secret
# GAME_PUBLIC_ORIGIN=https://your-game-host.example
# GAME_DB_POOL_SIZE=1
