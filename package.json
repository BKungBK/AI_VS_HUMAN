{
  "name": "human-vs-ai-neo-pastel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "qa": "node scripts/qa.mjs",
    "game:start": "tsx api/index.ts",
    "game:build": "tsc -p tsconfig.server.json && npm run build && npm run game:bundle",
    "game:bundle": "node scripts/bundle-game-api.mjs",
    "game:test": "tsx --test tests/game-contracts.ts tests/caption-contracts.ts tests/roulette-contracts.ts tests/whack-contracts.ts tests/shield-contracts.ts tests/piece-contracts.ts",
    "game:qa": "node scripts/game-browser-check.mjs",
    "game:qa2": "node scripts/game2-browser-check.mjs",
    "game:qa3": "node scripts/game3-browser-check.mjs",
    "game:qa4": "node scripts/game4-browser-check.mjs",
    "game:qa5": "node scripts/game5-browser-check.mjs",
    "game:qa6": "node scripts/game6-browser-check.mjs",
    "game:qa7": "node scripts/game7-browser-check.mjs",
    "game:load": "node scripts/game-load-check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@elysiajs/node": "1.4.5",
    "elysia": "1.4.30",
    "gsap": "3.14.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "1.56.0",
    "supabase": "^2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  }
}
